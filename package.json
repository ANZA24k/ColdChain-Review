{
  "name": "coldchain-review",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "test": "npm run test:contract && npm run test:audit",
    "test:contract": "python -m unittest discover -s tests -v",
    "test:audit": "node --experimental-strip-types --test tests/audit/*.test.mjs"
  },
  "dependencies": {
    "genlayer-js": "2.0.0",
    "lucide-react": "0.468.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "viem": "2.58.4"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.0",
    "typescript": "5.9.3",
    "vite": "7.3.8"
  }
}
